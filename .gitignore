# Byte-compiled / optimized
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment / secrets — never commit
.env
.env.local
*.pem

# Uploaded evidence is user data, not source code
uploads/*
!uploads/.gitkeep

# Local databases / dumps
*.sqlite
*.sqlite3
*.db
*.sql.gz
dumps/

# Testing & coverage
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.tox/

# Packaging
build/
dist/
*.egg-info/

# Logs
*.log

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
