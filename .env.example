# ---------------------------------------------------------------------------
# CampusCare configuration
#
# Copy this file to `.env` and edit:   cp .env.example .env
# `.env` is gitignored and must NEVER be committed.
#
# Every value below is the default, so the defaults alone give you a working
# local install against XAMPP MySQL (email disabled).
# ---------------------------------------------------------------------------

# development | production | testing
FLASK_ENV=development

# Signs session cookies, CSRF tokens and email action links.
# Generate a real one before deploying anywhere:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-only-insecure-secret-change-me

# Absolute base used to build links inside emails. An email is read outside the
# browser, so relative URLs do not work there. Set this to your real host in
# production, e.g. https://campuscare.yourcollege.edu
BASE_URL=http://127.0.0.1:5000

APP_NAME=CampusCare

# --- MySQL -----------------------------------------------------------------
# XAMPP defaults: user "root" with an empty password.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=rosp

# Alternatively set a full SQLAlchemy URL, which overrides the five settings
# above (useful for Docker, CI, or a hosted database):
# DATABASE_URL=mysql+pymysql://user:password@host:3306/campuscare?charset=utf8mb4

# --- Email -----------------------------------------------------------------
# Administrator notifications (new staff registrations, escalations) go here.
ADMIN_EMAIL=

# SMTP delivery. Leave SMTP_HOST blank to disable sending entirely: the app
# still runs and records every message in the email log, clearly marked as
# NOT SENT, so the workflow can be tested without credentials.
#
# For Gmail you must use an App Password, not your account password:
#   Google Account -> Security -> 2-Step Verification -> App passwords
# NEVER commit the real value. NEVER paste it into a chat or an issue.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_TIMEOUT=20

# The From: header. Defaults to SMTP_USER when blank.
# Example: EMAIL_FROM=CampusCare <you@gmail.com>
EMAIL_FROM=

# --- Two-step verification (OTP) -------------------------------------------
# Off by default: signing in is email + password only.
# Set to true to require a 6-digit emailed code as well. Recommended for any
# deployment reachable from a network -- it needs working SMTP above, or codes
# cannot be delivered.
TWO_FACTOR_ENABLED=false

# Seconds an OTP stays valid.
OTP_TTL_SECONDS=300
# Wrong guesses allowed before the code is burned.
OTP_MAX_ATTEMPTS=5
# Seconds a user must wait before requesting another code.
OTP_RESEND_COOLDOWN_SECONDS=60

# Lifetime of signed links emailed to staff (password setup). Seconds; 48h.
ACTION_TOKEN_TTL_SECONDS=172800

# --- Evidence storage ------------------------------------------------------
# "local" writes under UPLOAD_DIR. "cloudinary" uses object storage, which is
# REQUIRED on any host with an ephemeral filesystem (Vercel, Render free, Fly)
# -- otherwise photos are wiped on every redeploy. See docs/DEPLOYMENT.md.
STORAGE_BACKEND=local

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=campuscare

# --- Evidence upload -------------------------------------------------------
# Where uploaded photos are written. This directory is NEVER served as static
# files; every image is streamed through a permission check.
UPLOAD_DIR=./uploads

# Maximum size of a single photo, in megabytes.
MAX_FILE_SIZE_MB=5

# Maximum number of photos per complaint.
MAX_FILES_PER_COMPLAINT=5

# --- Cookies ---------------------------------------------------------------
# Set to true when serving over HTTPS.
SESSION_COOKIE_SECURE=false
